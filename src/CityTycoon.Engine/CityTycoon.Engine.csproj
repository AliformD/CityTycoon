<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Bake every JSON file from /content into the Engine, so it can always find them. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\content\*.json" LogicalName="CityTycoon.Content.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
