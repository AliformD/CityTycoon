@* The big buttons in the middle of the board for whatever the current person must decide. *@
@{
    var decision = Request.Decision;
    var view = Request.View;
    var main = Request.LegalActions.Where(a => a is not ManagementAction and not PlayCard).ToList();
    var plays = Request.LegalActions.OfType<PlayCard>().ToList();
    var manage = Request.LegalActions.OfType<ManagementAction>().ToList();
}
@if (decision.Kind == DecisionKind.SubmitBid)
{
    <AuctionPanel Request="Request" Content="Content" OnAnswer="OnAnswer" />
}
else if (decision.Kind is DecisionKind.ChooseOrdinance or DecisionKind.ChooseDistrict or DecisionKind.CouncilVote or DecisionKind.OfferVoteDeal or DecisionKind.AnswerVoteDeal)
{
    <CouncilPanel Request="Request" Content="Content" OnAnswer="OnAnswer" />
}
else if (decision.Kind == DecisionKind.RaiseMoney)
{
    @* Owes more than they have (Section 15.10): every way to raise cash is listed as a button. *@
    <div class="decision raise-money">
        <h2>@view.Me.Name, you need to raise money</h2>
        <p>@decision.Prompt</p>
        <p>Still needed: <strong>@UiHelpers.Money(Math.Max(0, decision.AmountOwed - view.Me.Cash))</strong>.</p>
        <div class="buttons stacked">
            @foreach (var action in manage)
            {
                <button class="big" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
            }
            @foreach (var action in main)
            {
                <button class="big danger" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.RespondToTrade && decision.Trade is { } offer)
{
    <div class="decision trade-offer">
        <h2>@view.Me.Name, @view.Player(offer.FromId).Name @(decision.CountersLeft < Content.Rules.MaxTradeCounters ? "sent you a counter-offer" : "offers you a trade")</h2>
        @if (decision.CountersLeft < Content.Rules.MaxTradeCounters && decision.Prompt.IndexOf('"') is int quote and >= 0)
        {
            @* A bot says why it countered, so you know what to change. *@
            <p class="trade-why">@view.Player(offer.FromId).Name says: @decision.Prompt[quote..]</p>
        }
        <div class="trade-sides">
            <div><h3>You get</h3>@TradeSide(offer.GiveCash, offer.GiveProperties, offer.GiveCards)</div>
            <div><h3>You give</h3>@TradeSide(offer.GetCash, offer.GetProperties, offer.GetCards)</div>
        </div>
        @if (showCounter)
        {
            <TradeBuilder Request="Request" Content="Content" Session="Session" CounterTo="offer" OnCounter="Counter" OnCancel="CloseCounter" />
        }
        else
        {
            <div class="buttons">
                @foreach (var action in main)
                {
                    <button class="big @(action is AcceptTrade ? "primary" : "")" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
                }
                @if (decision.CountersLeft > 0)
                {
                    <button class="big" @onclick="OpenCounter">Counter-offer…</button>
                }
            </div>
            <p class="hint">@CountersHint(decision.CountersLeft)</p>
        }
    </div>
}
else if (decision.Kind == DecisionKind.ChoosePrecisionDice && decision.Dice is { Count: 3 } dice)
{
    @* Precision Roll (Section 10.3): three dice were rolled, keep the two you like. *@
    <div class="decision precision">
        <h2>@view.Me.Name, keep two of these dice</h2>
        <div class="dice three" aria-label="Your three dice: @string.Join(", ", dice)">
            @foreach (var die in dice) { <Die Value="die" /> }
        </div>
        <div class="buttons stacked">
            @* Two dice the same (like 2, 2, 6) would give the same choice twice, so each pair of numbers is shown once. *@
            @foreach (var action in main.OfType<ChooseDice>().DistinctBy(c => (Math.Min(dice[c.First], dice[c.Second]), Math.Max(dice[c.First], dice[c.Second]))))
            {
                var a = dice[action.First];
                var b = dice[action.Second];
                var land = UiHelpers.LandingSpace(view, Request.PlayerId, a + b);
                <button class="big" @onclick="() => OnAnswer.InvokeAsync(action)"
                        @onmouseover="() => Preview(land.Id)" @onfocus="() => Preview(land.Id)">
                    Keep @a and @b = @(a + b)@(a == b ? " (doubles!)" : "") → @UiHelpers.DisplayName(land, Content)
                </button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.ChooseNudge)
{
    @* Nudge (Section 7.3): 1 Momentum token per space, up to 2 spaces more or less (the Commuter 4). The board lights up where each choice lands. *@
    var rolled = decision.Dice?.Sum() ?? 0;
    <div class="decision nudge">
        <h2>@view.Me.Name, you rolled @rolled. Nudge it?</h2>
        <p>You have @view.Me.Momentum Momentum token@(view.Me.Momentum == 1 ? "" : "s"). Point at a choice to see where it lands.</p>
        <div class="buttons nudge-options">
            @foreach (var action in main.OfType<Nudge>().OrderBy(n => n.Spaces))
            {
                var land = UiHelpers.LandingSpace(view, Request.PlayerId, rolled + action.Spaces);
                <button class="big @(action.Spaces == 0 ? "primary" : "")" @onclick="() => OnAnswer.InvokeAsync(action)"
                        @onmouseover="() => Preview(land.Id)" @onmouseout="() => Preview(null)"
                        @onfocus="() => Preview(land.Id)" @onblur="() => Preview(null)">
                    <span>@UiHelpers.ActionLabel(action, view, Content)</span>
                    <small>Move @(rolled + action.Spaces) → @UiHelpers.DisplayName(land, Content)</small>
                </button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.CasinoBet)
{
    <CasinoPanel Request="Request" Content="Content" OnAnswer="OnAnswer" />
}
else if (decision.Kind == DecisionKind.RespondToDuel && decision.Duel is { } duel)
{
    <div class="decision duel">
        <h2>@view.Me.Name, @view.Player(duel.ChallengerId).Name challenges you to a Dice Duel!</h2>
        <p>You each roll two dice and the higher total wins <strong>@UiHelpers.Money(duel.Stake)</strong> from the other. Ties roll again.</p>
        <div class="buttons">
            @foreach (var action in main)
            {
                <button class="big @(action is AcceptDuel ? "primary" : "")" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.ChooseStadiumGroup)
{
    @* The Stadium (Section 13.3): pick a color group whose rent doubles until your next turn. *@
    <div class="decision stadium">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="buttons groups">
            @foreach (var action in main.OfType<PickStadiumGroup>())
            {
                var group = Content.Groups[action.GroupId];
                <button class="group-choice" @onclick="() => OnAnswer.InvokeAsync(action)">
                    <span class="band" style="background:@group.Color"></span>
                    <strong>@group.Name</strong>
                    <small>@GroupOwners(action.GroupId)</small>
                </button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.PlayReaction)
{
    @* A Reaction window (Section 17.2): only players holding a matching card are asked. *@
    <div class="decision reaction">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        @if (decision.Cards is { Count: > 0 } trigger)
        {
            <div class="cards"><CardView CardId="@trigger[0]" Content="Content" /></div>
        }
        <div class="buttons stacked">
            @foreach (var play in plays)
            {
                if (Content.Card(play.CardId).EffectType == "Detour" && decision.OtherPlayerId is int mover)
                {
                    var land = UiHelpers.LandingSpace(view, mover, decision.Spaces + play.Number);
                    <button class="big" @onclick="() => OnAnswer.InvokeAsync(play)"
                            @onmouseover="() => Preview(land.Id)" @onmouseout="() => Preview(null)"
                            @onfocus="() => Preview(land.Id)" @onblur="() => Preview(null)">
                        <span>@UiHelpers.ActionLabel(play, view, Content)</span>
                        <small>@view.Player(mover).Name lands on @UiHelpers.DisplayName(land, Content) instead</small>
                    </button>
                }
                else
                {
                    <button class="big primary" @onclick="() => OnAnswer.InvokeAsync(play)">@UiHelpers.ActionLabel(play, view, Content)</button>
                }
            }
            @foreach (var action in main)
            {
                <button class="big" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
            }
        </div>
        <label class="toggle"><input type="checkbox" checked="@Session.AutoPassesReactions(Request.PlayerId)"
               @onchange="e => Session.SetAutoPassReactions(Request.PlayerId, e.Value is true)" /> Always pass on reactions from now on</label>
    </div>
}
else if (decision.Kind == DecisionKind.TransitHop)
{
    @* Transit Hub next door (Section 12.3): pay the rent, or pay the hop fee and move onto the hub. *@
    <div class="decision transit">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="buttons">
            <button class="big" @onclick="() => OnAnswer.InvokeAsync(new NoThanks())">Pay @UiHelpers.Money(decision.AmountOwed) rent</button>
            <button class="big primary" @onclick="() => OnAnswer.InvokeAsync(new HopToTransitHub())">@UiHelpers.ActionLabel(new HopToTransitHub(), view, Content)</button>
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.MallVisit)
{
    @* The Mall (Section 15.3): three face-up cards for sale, cheapest on the left. Or sell one of yours. *@
    <div class="decision mall">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="cards">
            @for (int i = 0; i < view.MallShop.Count; i++)
            {
                // A copy of the loop number: the card's button is drawn later, after the loop has moved on.
                int slot = i;
                var buy = new BuyCard(slot);
                <CardView CardId="@view.MallShop[slot]" Content="Content">
                    <button class="small primary" disabled="@(!main.Contains(buy))" @onclick="() => OnAnswer.InvokeAsync(buy)">Buy for @UiHelpers.Money(Content.Rules.MallPrices[slot])</button>
                </CardView>
            }
        </div>
        @if (main.OfType<SellCard>().Any())
        {
            <h3>Or sell one of your cards for @UiHelpers.Money(Content.Rules.MallSellPrice)</h3>
            <div class="buttons">
                @foreach (var sell in main.OfType<SellCard>())
                {
                    <button class="small" @onclick="() => OnAnswer.InvokeAsync(sell)">@UiHelpers.ActionLabel(sell, view, Content)</button>
                }
            </div>
        }
        <div class="buttons"><button class="big" @onclick="() => OnAnswer.InvokeAsync(new NoThanks())">Just browsing</button></div>
    </div>
}
else if (decision.Kind == DecisionKind.DiscardCards)
{
    <div class="decision discard">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="cards">
            @foreach (var cardId in view.MyHand.Distinct())
            {
                var discard = new DiscardCard(cardId);
                <CardView CardId="@cardId" Content="Content">
                    <button class="small" @onclick="() => OnAnswer.InvokeAsync(discard)">Discard</button>
                </CardView>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.ArrangeEvents && decision.Cards is { } top)
{
    @* Tip-Off: only this player sees these cards. Each button is one order, top card first. *@
    <div class="decision arrange">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="cards">
            @foreach (var cardId in top) { <CardView CardId="@cardId" Content="Content" /> }
        </div>
        <div class="buttons stacked">
            @foreach (var arrange in main.OfType<ArrangeCards>())
            {
                <button class="small" @onclick="() => OnAnswer.InvokeAsync(arrange)">
                    @string.Join(" → ", arrange.Order.Select(i => Content.Card(top[i]).Name))
                </button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.ChooseCharacter)
{
    @* Character pick (Section 5): each card is one character and what it does. *@
    <div class="decision characters">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="buttons groups">
            @foreach (var action in main.OfType<PickCharacter>())
            {
                var character = Content.Character(action.CharacterId);
                <button class="group-choice" @onclick="() => OnAnswer.InvokeAsync(action)">
                    <strong>@character.Name</strong>
                    <small>@character.Text</small>
                </button>
            }
        </div>
    </div>
}
else if (decision.Kind is DecisionKind.ChooseReroll or DecisionKind.RerollMove)
{
    <div class="decision reroll">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="buttons">
            @foreach (var action in main)
            {
                <button class="big @(action is RerollDice ? "primary" : "")" @onclick="() => OnAnswer.InvokeAsync(action)">@RerollLabel(action, decision)</button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.ReverseCouncilVote)
{
    @* City Planner: once per game, turn a City Council result around. *@
    <div class="decision reverse-vote">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="buttons">
            @foreach (var action in main)
            {
                <button class="big @(action is NoThanks ? "primary" : "")" @onclick="() => OnAnswer.InvokeAsync(action)">@(action is NoThanks ? "Let it stand" : UiHelpers.ActionLabel(action, view, Content))</button>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.KeepCard && decision.Cards is { } drawn)
{
    @* Pink perk: two cards were drawn, keep one. *@
    <div class="decision keep-card">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="cards">
            @foreach (var cardId in drawn.Distinct())
            {
                var keep = new KeepCard(cardId);
                <CardView CardId="@cardId" Content="Content">
                    <button class="small primary" @onclick="() => OnAnswer.InvokeAsync(keep)">Keep this one</button>
                </CardView>
            }
        </div>
    </div>
}
else if (decision.Kind == DecisionKind.PeekTile)
{
    @* City Planner: look at one hidden government tile. *@
    <div class="decision peek">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="buttons stacked">
            @foreach (var action in main)
            {
                <button class="big" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
            }
        </div>
    </div>
}
else
{
    <div class="decision">
        <h2>@view.Me.Name, @AfterName(decision.Prompt)</h2>
        <div class="buttons">
            @foreach (var action in main)
            {
                <button class="big @(action == main[0] ? "primary" : "")" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
            }
        </div>

        <HandPanel Request="Request" Content="Content" OnAnswer="OnAnswer" />

        @if (decision.Management != ManagementOptions.None)
        {
            @* The "in between" actions you can take before answering (Section 7.2). *@
            <div class="money-tools" aria-label="Manage your money">
                @foreach (var action in manage.Where(a => a is TakeLoan or RepayLoan))
                {
                    <button class="small" @onclick="() => OnAnswer.InvokeAsync(action)">@UiHelpers.ActionLabel(action, view, Content)</button>
                }
                @if (Session.Engine!.CanProposeTrade(Request.PlayerId))
                {
                    <button class="small" aria-expanded="@showTrade" @onclick="() => showTrade = !showTrade">@(showTrade ? "Close trade" : "Offer a trade…")</button>
                }
                @if (decision.Management.HasFlag(ManagementOptions.Build) || decision.Management.HasFlag(ManagementOptions.Mortgage))
                {
                    <p class="hint">Click one of your properties on the board to build, sell or mortgage.</p>
                }
            </div>
            @if (showTrade)
            {
                <TradeBuilder Request="Request" Content="Content" Session="Session" OnPropose="Propose" />
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public HumanRequest Request { get; set; } = default!;
    [Parameter, EditorRequired] public GameContent Content { get; set; } = default!;
    [Parameter, EditorRequired] public GameSession Session { get; set; } = default!;
    [Parameter] public EventCallback<GameAction> OnAnswer { get; set; }

    /// <summary>Called with a space id to light up on the board while the player points at a choice (null clears it).</summary>
    [Parameter] public EventCallback<string?> OnPreview { get; set; }

    private bool showTrade;

    private RenderFragment TradeSide(int cash, IReadOnlyList<string> properties, IReadOnlyList<string> cards) => __builder =>
    {
        <ul>
            @if (cash > 0) { <li>@UiHelpers.Money(cash) cash</li> }
            @foreach (var id in properties) { <li>@Content.Property(id).Name@(Request.View.Properties[id].IsMortgaged ? " (mortgaged)" : "")</li> }
            @foreach (var id in cards) { <li>@Content.Card(id).Name card <span class="hint">(@Content.Card(id).Text)</span></li> }
            @if (cash == 0 && properties.Count == 0 && cards.Count == 0) { <li>Nothing</li> }
        </ul>
    };

    /// <summary>"Roll the 2 again" for the Hustler's one-die reroll (decision #153), "Roll again" for a whole roll, "Keep it" otherwise.</summary>
    private string RerollLabel(GameAction action, PendingDecision decision) => action switch
    {
        RerollDice { Die: int die } when decision.Dice is { } dice && die < dice.Count => $"🔁 Roll the {dice[die]} again",
        RerollDice => UiHelpers.ActionLabel(action, Request.View, Content),
        _ => "Keep it",
    };

    // "Angel, " + "Anything else?" reads better as "Angel, anything else?".
    // A prompt that starts with someone's name ("Cal is about to move") keeps its capital letter.
    private string AfterName(string prompt) =>
        prompt.Length > 1 && char.IsUpper(prompt[0]) && char.IsLower(prompt[1])
            && !Request.View.Players.Any(p => prompt.StartsWith(p.Name + " ", StringComparison.Ordinal))
            ? char.ToLowerInvariant(prompt[0]) + prompt[1..]
            : prompt;

    private Task Preview(string? spaceId) => OnPreview.InvokeAsync(spaceId);

    /// <summary>Who owns what in a color group, e.g. "You 2, Bo 1, 1 unsold".</summary>
    private string GroupOwners(string groupId)
    {
        var ids = Content.Properties.Values.Where(p => p.Group == groupId).Select(p => p.Id).ToList();
        var owners = ids.Select(id => Request.View.Properties[id].OwnerId).ToList();
        var parts = owners.Where(o => o != null).GroupBy(o => o!.Value)
            .Select(g => $"{(g.Key == Request.PlayerId ? "You" : Request.View.Player(g.Key).Name)} {g.Count()}").ToList();
        int unsold = owners.Count(o => o == null);
        if (unsold > 0) parts.Add($"{unsold} unsold");
        return string.Join(", ", parts);
    }

    private async Task Propose(TradeOffer offer)
    {
        showTrade = false;
        await OnAnswer.InvokeAsync(new ProposeTrade(offer));
    }

    private bool showCounter;

    private void OpenCounter() => showCounter = true;
    private void CloseCounter() => showCounter = false;

    private async Task Counter(TradeOffer offer)
    {
        showCounter = false;
        await OnAnswer.InvokeAsync(new CounterTrade(offer));
    }

    private static string CountersHint(int left) => left switch
    {
        0 => "No more counter-offers on this trade: accept or decline it.",
        1 => "This is the last counter-offer this trade can have.",
        _ => $"This trade can have {left} more counter-offers.",
    };
}
