@* The last roll, drawn as real dice with dots (and the number as text too). While a roll is being replayed, the dice tumble first. *@
@if (Rolling)
{
    <div class="dice rolling" aria-hidden="true">
        <Die Value="RollingFaces.Item1" />
        <Die Value="RollingFaces.Item2" />
    </div>
}
else if (Roll != null)
{
    @* @key makes a new roll replace the old dice, so the landing animation plays again. *@
    <div class="dice" @key="Roll" aria-label="@(Roll.IsOneDie ? $"Last roll: {Roll.Die1} on one die" : $"Last roll: {Roll.Die1} and {Roll.Die2}")">
        <Die Value="Roll.Die1" />
        @if (!Roll.IsOneDie)
        {
            <Die Value="Roll.Die2" />
        }
        <span class="dice-caption">@View.Player(Roll.PlayerId).Name rolled @Roll.Total@(Roll.IsDoubles ? ", doubles!" : "")</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public PlayerView View { get; set; } = default!;
    [Parameter] public bool Rolling { get; set; }
    [Parameter] public (int, int) RollingFaces { get; set; } = (1, 1);
    private DiceRolled? Roll => View.Log.OfType<DiceRolled>().LastOrDefault();
}
