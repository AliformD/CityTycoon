@* A small line-drawn picture, drawn with SVG so it looks the same on every device (emoji differ between phones and PCs).
   Name picks the picture; Label, when set, is read out by screen readers. Without a Label the icon is decoration and hidden from them. *@
<svg class="icon icon-@Name @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Label == null ? "true" : "false")" role="@(Label == null ? null : "img")" aria-label="@Label" focusable="false">
    @switch (Name)
    {
        case "dice":
            <rect x="3" y="3" width="18" height="18" rx="4" /><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" /><circle cx="12" cy="12" r="1.2" fill="currentColor" /><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" />
            break;
        case "walk":
            <path d="M5 12h12M13 6l6 6-6 6" />
            break;
        case "turn":
            <circle cx="12" cy="12" r="9" /><path d="M10 8l4 4-4 4" />
            break;
        case "coin":
            <circle cx="12" cy="12" r="9" /><path d="M15 9a3 2 0 0 0-3-1.5c-2 0-3 1-3 2s1 1.6 3 2 3 1 3 2-1 2-3 2a3 2 0 0 1-3-1.5M12 6v12" />
            break;
        case "jail":
            <rect x="4" y="4" width="16" height="16" rx="2" /><path d="M9 4v16M15 4v16M4 12h16" />
            break;
        case "unlock":
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 7.5-2" />
            break;
        case "gavel":
            <path d="M14 4l6 6M11 7l6 6M12.5 5.5l-5 5M3 21l7-7M4 20h8" />
            break;
        case "house":
            <path d="M3 11l9-7 9 7M5 10v10h14V10M10 20v-6h4v6" />
            break;
        case "build":
            <path d="M4 20h16M6 20V10l6-4 6 4v10M10 14h4M10 17h4" />
            break;
        case "fire":
            <path d="M12 3c1 3 5 5 5 10a5 5 0 0 1-10 0c0-2.5 1.5-3.5 2-5 1 1.5 2 2 3 2 0-2.5-.5-4.5 0-7z" />
            break;
        case "trade":
            <path d="M4 8h13l-3-3M20 16H7l3 3" />
            break;
        case "event":
            <path d="M13 2L4 14h7l-1 8 9-12h-7z" />
            break;
        case "card":
            <rect x="5" y="3" width="14" height="18" rx="2" /><path d="M10 9a2 2 0 1 1 3 1.7c-.7.4-1 .9-1 1.6M12 16v.5" />
            break;
        case "shield":
            <path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z" />
            break;
        case "gov":
            <path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z" /><path d="M12 9v4M12 16v.5" />
            break;
        case "shop":
            <path d="M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2" />
            break;
        case "council":
        case "landmark":
            <path d="M3 9l9-6 9 6M5 9v9M9.5 9v9M14.5 9v9M19 9v9M3 21h18" />
            break;
        case "bankrupt":
            <circle cx="12" cy="12" r="9" /><path d="M8 8l8 8M16 8l-8 8" />
            break;
        case "flag":
            <path d="M5 21V4M5 4h11l-2 4 2 4H5" />
            break;
        case "tax":
            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6" />
            break;
        case "train":
            <rect x="6" y="3" width="12" height="13" rx="3" /><path d="M6 10h12M9 20l-2 2M15 20l2 2M9 13h.5M14.5 13h.5" />
            break;
        case "bulb":
            <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z" />
            break;
        case "park":
            <path d="M12 3l5 8h-3l4 6H6l4-6H7zM12 17v4" />
            break;
        case "go":
            <path d="M19 12H5M11 6l-6 6 6 6" />
            break;
        case "police":
            <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6zM9 12l2 2 4-4" />
            break;
        case "star":
            <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" />
            break;
        case "party":
            <path d="M4 20l5-13 8 8zM14 4v2M18 6l-1.5 1.5M20 10h-2" />
            break;
        case "stadium":
            <ellipse cx="12" cy="9" rx="9" ry="4" /><path d="M3 9v6c0 2.2 4 4 9 4s9-1.8 9-4V9" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />
            break;
        case "cone":
            <path d="M10 4h4l4 15H6zM8.5 10h7M7.5 14h9M4 19h16" />
            break;
        case "permit":
            <path d="M6 3h9l3 3v15H6zM9 10h6M9 14h6M9 18h3" />
            break;
        case "medic":
            <path d="M10 4h4v6h6v4h-6v6h-4v-6H4v-4h6z" />
            break;
        case "skip":
            <path d="M5 5l9 7-9 7zM17 5v14" />
            break;
        case "book":
            <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 19V5" />
            break;
        case "gear":
            <circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" />
            break;
        case "save":
            <path d="M5 3h11l3 3v15H5zM8 3v6h7V3M8 21v-7h8v7" />
            break;
        case "download":
            <path d="M12 3v12M7 10l5 5 5-5M4 21h16" />
            break;
        case "home":
            <path d="M3 11l9-8 9 8M5 10v11h14V10" />
            break;
        case "sound":
            <path d="M4 9h4l5-4v14l-5-4H4zM16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" />
            break;
        case "mute":
            <path d="M4 9h4l5-4v14l-5-4H4zM17 9l5 6M22 9l-5 6" />
            break;
        case "eye":
            <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "moon":
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        default:
            <circle cx="12" cy="12" r="3" fill="currentColor" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
