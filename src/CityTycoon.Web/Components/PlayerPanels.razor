@* One card per player: cash (big), then net worth, properties and anything special going on. *@
<section class="players" aria-label="Players">
    @foreach (var p in View.Players)
    {
        <article class="player-card @(p.IsActive && !View.IsOver ? "active" : "") @(p.IsBankrupt ? "bankrupt" : "")" style="--player:@UiHelpers.PlayerColor(p.Id)">
            <header>
                @{ var ledgerId = p.Id; }
                <button class="token ledger-button" style="background:@UiHelpers.PlayerColor(p.Id)" title="Open @(p.Name)'s money ledger"
                        aria-label="Open @(p.Name)'s money ledger" @onclick="() => OnOpenLedger.InvokeAsync(ledgerId)">@UiHelpers.Initial(p.Name)</button>
                <div class="who">
                    <strong>@p.Name</strong>
                    <span class="seat-kind">@SeatLabel(p.Id)@(p.CharacterId != null ? " · " + Session.Content.Character(p.CharacterId).Name : "")</span>
                </div>
                @if (p.IsActive && !View.IsOver) { <span class="badge">Their turn</span> }
            </header>
            @if (p.IsBankrupt)
            {
                <p class="status">Bankrupt</p>
            }
            else
            {
                <p class="cash"><span class="visually-hidden">Cash </span>@UiHelpers.Money(p.Cash)
                    @* Money floats up from the cash amount while a move is replayed. *@
                    @foreach (var pop in Session.Playback.PopsFor(p.Id))
                    {
                        <span class="pop @(pop.Amount > 0 ? "up" : "down")" @key="pop.Number" aria-hidden="true">@(pop.Amount > 0 ? "+" : "−")@UiHelpers.Money(Math.Abs(pop.Amount))</span>
                    }
                </p>
                <dl>
                    <dt>Net worth</dt><dd>@UiHelpers.Money(p.NetWorth)</dd>
                    <dt>Properties</dt><dd>@View.Properties.Values.Count(x => x.OwnerId == p.Id)</dd>
                    <dt>Cards</dt><dd>@p.HandCount</dd>
                    <dt>Momentum</dt><dd><span class="momentum" aria-hidden="true">@for (int m = 0; m < p.MomentumCap; m++) { <span class="@(m < p.Momentum ? "on" : "")"></span> }</span> @p.Momentum of @p.MomentumCap</dd>
                    @if (p.Loans > 0) { <dt>Loans</dt><dd>@p.Loans (repay @UiHelpers.Money(p.LoanDebt))</dd> }
                    @{ var pending = View.Properties.Values.Where(x => x.OwnerId == p.Id && x.IsPending).ToList(); }
                    @if (pending.Count > 0) { <dt>Pending</dt><dd>@pending.Count (owes @UiHelpers.Money(pending.Sum(x => x.PendingBalance)) at GO)</dd> }
                </dl>
                <div class="chips">
                    @if (p.InJail) { <span class="chip bad"><Icon Name="jail" /> In Jail@(p.JailTurns > 0 ? $" (turn {p.JailTurns})" : ""): rent halved</span> }
                    @if (p.IsInsured) { <span class="chip good"><Icon Name="medic" /> Insured</span> }
                    @if (p.IsRecovering) { <span class="chip"><Icon Name="medic" /> Recovering: rolls 1 die next turn</span> }
                    @if (p.HasRoadWork) { <span class="chip"><Icon Name="cone" /> Road Work: rolls 1 die next turn</span> }
                    @if (p.ExtraBuildsThisTurn > 0) { <span class="chip good"><Icon Name="permit" /> Construction Permit: +@p.ExtraBuildsThisTurn builds, @p.BuildDiscountThisTurn% off this turn</span> }
                    @foreach (var perk in p.Perks)
                    {
                        @* Hover for a tooltip, or click (tap) to show what the power does under the chips. *@
                        var (where, text) = PerkInfo(perk);
                        var playerId = p.Id;
                        <button type="button" class="chip perk @(IsOpen(playerId, perk) ? "open" : "")" title="@($"{perk}, {where}: {text}")"
                                aria-expanded="@(IsOpen(playerId, perk) ? "true" : "false")" @onclick="() => Toggle(playerId, perk)">
                            <Icon Name="star" /> @perk
                        </button>
                    }
                </div>
                @foreach (var perk in p.Perks.Where(x => IsOpen(p.Id, x)))
                {
                    var (where, text) = PerkInfo(perk);
                    <p class="perk-text"><strong>@perk</strong> <span class="small-print">(@where)</span><br />@text</p>
                }
                @if (p.CharacterId != null)
                {
                    var character = Session.Content.Character(p.CharacterId);
                    <details class="character">
                        <summary>@character.Name's power</summary>
                        <p>@character.Text</p>
                    </details>
                }
                @if (Session.IsHuman(p.Id))
                {
                    <label class="toggle small-print"><input type="checkbox" checked="@Session.AutoPassesReactions(p.Id)"
                           @onchange="e => Session.SetAutoPassReactions(p.Id, e.Value is true)" /> Auto-pass reactions</label>
                }
            }
        </article>
    }
</section>

@code {
    [Parameter, EditorRequired] public PlayerView View { get; set; } = default!;
    [Parameter, EditorRequired] public GameSession Session { get; set; } = default!;

    /// <summary>Clicking a player's letter circle opens their money ledger.</summary>
    [Parameter] public EventCallback<int> OnOpenLedger { get; set; }

    // Which perk explanations are open, per player. Only this screen needs to know.
    private readonly HashSet<(int PlayerId, string Perk)> openPerks = [];

    private bool IsOpen(int playerId, string perk) => openPerks.Contains((playerId, perk));

    private void Toggle(int playerId, string perk)
    {
        if (!openPerks.Remove((playerId, perk)))
            openPerks.Add((playerId, perk));
    }

    /// <summary>Where a perk comes from (a whole color group, or railroads/utilities) and what it does, from the content files.</summary>
    private (string Where, string Text) PerkInfo(string perk)
    {
        if (Session.Content.Groups.Values.FirstOrDefault(g => g.Perk.Name == perk) is { } group)
            return ($"from owning all of {group.Name}", group.Perk.Text);
        if (Session.Content.Bonuses.FirstOrDefault(b => b.Name == perk) is { } bonus)
            return ($"from owning {bonus.Count} {(bonus.PropertyType == PropertyType.Railroad ? "railroads" : "utilities")}", bonus.Text);
        return ("a power", "");
    }

    private string SeatLabel(int playerId) => Session.Seats.GetValueOrDefault(playerId) switch
    {
        SeatKind.Human => "Human",
        SeatKind.NormalBot => "Normal bot",
        SeatKind.HardBot => "Hard bot",
        _ => "Easy bot",
    };
}
