@* A property's details: group, assessed value, and its full rent table. *@
@{
    var def = Content.Property(PropertyId);
    var group = def.Group != null ? Content.Groups[def.Group] : null;
    View.Properties.TryGetValue(PropertyId, out var owned);
}
<div class="property-card">
    <div class="card-band" style="background:@(group?.Color ?? "#444")">
        @if (group != null) { <span class="code">@group.Code</span> }
        <strong>@def.Name</strong>
    </div>
    <p>
        @(def.Type switch { PropertyType.Railroad => "Railroad", PropertyType.Utility => "Utility", _ => group!.Name + " group" })
        · Assessed value <strong>@UiHelpers.Money(def.AssessedValue)</strong>
    </p>
    <p>Owner: <strong>@(owned?.OwnerId is int o ? View.Player(o).Name : "the bank")</strong>@(owned?.IsMortgaged == true ? " (mortgaged)" : "")</p>
    @if (owned?.IsPending == true)
    {
        <p>Pending: @UiHelpers.Money(owned.PendingBalance) is still owed at the owner's next GO. It collects no rent until then.</p>
    }
    @if (def.Type == PropertyType.Color && owned != null)
    {
        var district = View.Spaces.First(s => s.Id == PropertyId).DistrictId;
        <p>
            Buildings: <strong>@EventDescriber.LevelName(owned.Level)</strong>
            @if (district != null && View.Zoning.TryGetValue(district, out var zoning))
            {
                <span> · Zoning: <strong>@UiHelpers.ZoningName(zoning)</strong> (up to @EventDescriber.LevelName(Content.Rules.MaxBuildingLevel(zoning)))</span>
            }
        </p>
    }
    @{
        int index = View.Spaces.First(s => s.Id == PropertyId).Index;
        int n = View.Spaces.Count;
        var tiles = new[] { View.Spaces[(index - 1 + n) % n], View.Spaces[(index + 1) % n] }
            .Where(s => s.Kind == SpaceKind.GovernmentTile).ToList();
    }
    @foreach (var tile in tiles)
    {
        @if (tile.TileId == null)
        {
            <p class="tile-note">Next to a hidden Government tile. Nobody knows what it does yet.</p>
        }
        else
        {
            var info = Content.GovTile(tile.TileId);
            <p class="tile-note">Next to the <strong>@info.Name</strong>@(tile.IsHiddenTile ? " (only you know: it's still hidden, so it has no effect yet)" : ""): @info.NeighborText</p>
        }
    }
    @if (Breakdown is { } breakdown && owned?.OwnerId != null)
    {
        <table class="rents breakdown">
            <caption>Rent right now@(def.Type == PropertyType.Utility ? " (for a roll of 7)" : "")</caption>
            <tbody>
                @foreach (var line in breakdown.Lines)
                {
                    <tr><th scope="row">@line.Label</th><td>@line.Change</td></tr>
                }
                <tr class="current"><th scope="row">Rent</th><td>@UiHelpers.Money(breakdown.Total)</td></tr>
            </tbody>
        </table>
    }
    <table class="rents">
        <caption>@(Breakdown != null && owned?.OwnerId != null ? "Full rent table" : "Rent table")</caption>
        <tbody>
            @if (def.Type == PropertyType.Color)
            {
                string[] labels = ["Base rent", "1 house", "2 houses", "3 houses", "4 houses", "Hotel", "Skyscraper"];
                for (int level = 0; level < labels.Length; level++)
                {
                    <tr class="@(owned?.Level == level && owned.OwnerId != null ? "current" : "")"><th scope="row">@labels[level]</th><td>@UiHelpers.Money(def.Rents![level])</td></tr>
                }
                <tr><th scope="row">Whole group, no buildings</th><td>@UiHelpers.Money(def.Rents![0] * 2)</td></tr>
                <tr><th scope="row">Cost per building level</th><td>@UiHelpers.Money(def.HouseCost)</td></tr>
                @if (owned != null && owned.OwnerId != null && owned.Level < Content.Rules.SkyscraperLevel && owned.NextLevelCost != CityTycoon.Engine.Rules.BuildingRules.LevelCost(Content, def, owned.Level + 1))
                {
                    <tr class="current"><th scope="row">Next level, with discounts</th><td>@UiHelpers.Money(owned.NextLevelCost)</td></tr>
                }
            }
            else if (def.Type == PropertyType.Railroad)
            {
                for (int i = 0; i < Content.Rules.RailroadRents.Count; i++)
                {
                    <tr><th scope="row">Own @(i + 1) railroad@(i > 0 ? "s" : "")</th><td>@UiHelpers.Money(Content.Rules.RailroadRents[i])</td></tr>
                }
            }
            else
            {
                for (int i = 0; i < Content.Rules.UtilityRentMultipliers.Count; i++)
                {
                    <tr><th scope="row">Own @(i + 1) utilit@(i > 0 ? "ies" : "y")</th><td>@Content.Rules.UtilityRentMultipliers[i] × dice total</td></tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public string PropertyId { get; set; } = "";
    [Parameter, EditorRequired] public PlayerView View { get; set; } = default!;
    [Parameter, EditorRequired] public GameContent Content { get; set; } = default!;

    /// <summary>How the rent is worked out right now (from the engine), shown when the property is owned.</summary>
    [Parameter] public CityTycoon.Engine.Rules.RentBreakdown? Breakdown { get; set; }
}
