@* One square on the board: color band, name, owner, and any player tokens standing on it. *@
@{
    var (col, row) = UiHelpers.GridCell(Space.Index);
    var group = UiHelpers.GroupOf(Content, Space.Id);
    View.Properties.TryGetValue(Space.Id, out var owned);
    var def = Content.Properties.GetValueOrDefault(Space.Id);
    var tokens = View.Players.Where(p => !p.IsBankrupt && p.Position == Space.Index).ToList();
    string name = UiHelpers.DisplayName(Space, Content);
    string label = Space.IsHiddenTile ? "Hidden Government tile" : name;
    if (owned?.OwnerId is int ownerForLabel)
        label += $", owned by {View.Player(ownerForLabel).Name}";
    if (owned is { Level: > 0 })
        label += $", {EventDescriber.LevelName(owned.Level)}";
    if (owned?.IsMortgaged == true)
        label += ", mortgaged";
    if (owned?.IsPending == true)
        label += ", pending";
    if (group != null && View.StadiumBoosts.Any(b => b.GroupId == group.Id))
        label += ", rent doubled by the Stadium";
    var opening = View.PropertyBoosts.FirstOrDefault(b => b.PropertyId == Space.Id);
    if (opening != null)
        label += $", Grand Opening: rent ×{opening.Multiplier}";
}
<button class="space side-@UiHelpers.Side(Space.Index) kind-@Space.Kind.ToString().ToLowerInvariant() @(owned?.IsMortgaged == true ? "mortgaged" : "") @(Highlight ? "highlight" : "") @(Preview ? "preview" : "") @(PreviewFocus ? "preview-focus" : "") @(Flash ? "flash flash-" + FlashTone : "")"
        style="grid-column:@col; grid-row:@row;"
        title="@label"
        aria-label="@label"
        @onclick="() => OnSelect.InvokeAsync(Space)">
    @if (group != null)
    {
        bool boosted = View.StadiumBoosts.Any(b => b.GroupId == group.Id);
        <span class="band" style="background:@group.Color">
            @if (owned is { Level: > 0 and <= 4 })
            {
                @for (int h = 0; h < owned.Level; h++)
                {
                    <span class="house"></span>
                }
            }
            else if (owned is { Level: 5 })
            {
                <span class="hotel">H</span>
            }
            else if (owned is { Level: >= 6 })
            {
                <span class="hotel tower">S</span>
            }
            @if (boosted)
            {
                <span class="boost-x2">×2</span>
            }
        </span>
    }
    else
    {
        <Icon Name="@UiHelpers.KindIconName(Space, def)" Class="space-icon" />
    }
    @if (UiHelpers.IsCorner(Space))
    {
        <span class="corner-title">@CornerTitle()</span>
        <span class="corner-sub">@CornerSub()</span>
    }
    else
    {
        <span class="name">@name</span>
    }
    @if (def != null && owned?.OwnerId == null)
    {
        <span class="price">@UiHelpers.Money(def.AssessedValue)</span>
    }
    @if (owned?.OwnerId is int ownerId)
    {
        <span class="owner" style="background:@UiHelpers.PlayerColor(ownerId)" aria-hidden="true">@UiHelpers.Initial(View.Player(ownerId).Name)</span>
        @if (owned.IsMortgaged || owned.IsPending)
        {
            <span class="owner-note" aria-hidden="true">@(owned.IsMortgaged ? "M" : "P")</span>
        }
        @if (opening != null)
        {
            <Icon Name="party" Class="opening" />
        }
    }
    @if (tokens.Count > 0)
    {
        <span class="tokens @(tokens.Count > 2 ? "crowded" : "")">
            @foreach (var p in tokens)
            {
                <span class="token @(p.IsActive ? "active" : "")" @key="p.Id" style="background:@UiHelpers.PlayerColor(p.Id)" title="@p.Name">@UiHelpers.Initial(p.Name)</span>
            }
        </span>
    }
</button>

@code {
    [Parameter, EditorRequired] public SpaceInfo Space { get; set; } = default!;
    [Parameter, EditorRequired] public PlayerView View { get; set; } = default!;
    [Parameter, EditorRequired] public GameContent Content { get; set; } = default!;
    [Parameter] public bool Highlight { get; set; }
    [Parameter] public bool Preview { get; set; }
    [Parameter] public bool PreviewFocus { get; set; }

    /// <summary>Flashed while the replay is talking about this space. The tone is "good", "bad" or empty.</summary>
    [Parameter] public bool Flash { get; set; }
    [Parameter] public string FlashTone { get; set; } = "";
    [Parameter] public EventCallback<SpaceInfo> OnSelect { get; set; }

    private string CornerTitle() => Space.Kind switch
    {
        SpaceKind.Go => "GO",
        SpaceKind.Jail => "JAIL",
        SpaceKind.CityPark => "CITY PARK",
        _ => "GO TO JAIL",
    };

    private string CornerSub() => Space.Kind switch
    {
        SpaceKind.Go => $"Collect {UiHelpers.Money(Content.Rules.GoSalary)}",
        SpaceKind.Jail => "Just visiting",
        SpaceKind.CityPark => "Take a break",
        _ => "Do not pass GO",
    };
}
