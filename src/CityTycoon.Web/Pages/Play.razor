@page "/play"
@implements IDisposable
@inject GameSession Session
@inject NavigationManager Nav

<PageTitle>City Tycoon</PageTitle>

@if (!Session.HasGame)
{
    <main class="menu">
        <p>No game is running.</p>
        <button class="big primary" @onclick='() => Nav.NavigateTo("")'>Back to the menu</button>
    </main>
}
else
{
    var view = Session.PublicView;
    var request = Session.Request;
    <div class="game">
        <BoardView View="view" Content="Session.Content" HighlightSpaceId="@selectedSpaceId" OnSelect="Select"
                   PreviewSpaceIds="PreviewSpots(request)" PreviewFocusId="@previewFocusId"
                   FlashSpaceId="@Session.Playback.FlashSpaceId" FlashTone="@Session.Playback.FlashTone">
            <CaptionView Playback="Session.Playback" Content="Session.Content" />
            <DiceView View="view" Rolling="Session.Playback.Rolling" RollingFaces="Session.Playback.RollingFaces" />
            @if (Session.Error != null)
            {
                <p class="error" role="alert">Something went wrong: @Session.Error</p>
            }
            else if (view.IsOver)
            {
                <EndScreen View="view" Content="Session.Content" OnNewGame='() => { Session.Quit(); Nav.NavigateTo(""); }' />
            }
            else if (request != null && !Session.ShowPassScreen)
            {
                <DecisionPanel Request="request" Content="Session.Content" Session="Session" OnAnswer="Answer" OnPreview="id => previewFocusId = id" />
            }
            else if (request == null && !Session.Playback.IsPlaying)
            {
                <p class="waiting">Waiting for @string.Join(", ", view.WaitingOn.Select(id => view.Player(id).Name))…</p>
            }
            <GameLog View="view" Content="Session.Content" />
        </BoardView>

        <aside class="sidebar">
            <section class="city" aria-label="City">
                <strong>Round @view.Round@(view.Mode == GameMode.Timed ? $" of {view.MaxRounds}" : "")</strong>
                <span>@(view.Mode == GameMode.Timed ? "Timed game" : "Classic game")</span>
                <span class="council-next">City Council: next session at the end of round @view.NextCouncilRound</span>
                @foreach (var active in view.ActiveOrdinances)
                {
                    var ordinance = Session.Content.Ordinance(active.OrdinanceId);
                    <span class="boost">🏛️ @ordinance.Name@(active.DistrictId is string districtId ? $" ({Session.Content.Board.Districts.First(x => x.Id == districtId).Name})" : ""):
                        @(active.RoundsLeft is int left ? $"{left} round{(left == 1 ? "" : "s")} left" : "permanent")</span>
                }
                <span class="permits">Permits left: @view.HotelPermitsLeft hotel, @view.SkyscraperPermitsLeft skyscraper</span>
                @foreach (var boost in view.StadiumBoosts)
                {
                    <span class="boost">🏟️ @Session.Content.Groups[boost.GroupId].Name rent doubled by @view.Player(boost.ChosenById).Name</span>
                }
                @foreach (var boost in view.PropertyBoosts)
                {
                    <span class="boost">🎉 Grand Opening: @Session.Content.Property(boost.PropertyId).Name rent ×@boost.Multiplier until @view.Player(boost.ChosenById).Name's next turn</span>
                }
                <span class="decks">Opportunity deck @view.OpportunityDeckCount (discards @view.OpportunityDiscardCount) · Event deck @view.EventDeckCount (discards @view.EventDiscardCount)</span>
                <details>
                    <summary>For sale at the Mall</summary>
                    <ul class="zoning">
                        @for (int slot = 0; slot < view.MallShop.Count; slot++)
                        {
                            var card = Session.Content.Card(view.MallShop[slot]);
                            <li><strong>@card.Name</strong> (@UiHelpers.Money(Session.Content.Rules.MallPrices[slot])): @card.Text</li>
                        }
                    </ul>
                </details>
                <details>
                    <summary>Zoning by district</summary>
                    <ul class="zoning">
                        @foreach (var district in Session.Content.Board.Districts)
                        {
                            var zoning = view.Zoning[district.Id];
                            <li>@district.Name: <strong>@UiHelpers.ZoningName(zoning)</strong> (up to @EventDescriber.LevelName(Session.Content.Rules.MaxBuildingLevel(zoning)))@(view.ActiveOrdinances.Any(a => a.DistrictId == district.Id && Session.Content.Ordinance(a.OrdinanceId).EffectType == "Preserve") ? " 🔒 frozen" : "")</li>
                        }
                    </ul>
                </details>
            </section>
            <PlayerPanels View="view" Session="Session" />
            @if (selectedSpaceId != null && Session.Content.Properties.ContainsKey(selectedSpaceId))
            {
                <section class="detail" aria-label="Property details">
                    @if (request != null && !Session.ShowPassScreen && request.Decision.Management != ManagementOptions.None
                         && view.Properties[selectedSpaceId].OwnerId == request.PlayerId)
                    {
                        <PropertyActions PropertyId="@selectedSpaceId" Request="request" Content="Session.Content" Session="Session" OnAnswer="Session.Answer" />
                    }
                    <PropertyCard PropertyId="@selectedSpaceId" View="view" Content="Session.Content" Breakdown="Session.Engine!.ExplainRent(selectedSpaceId)" />
                    <button class="small" @onclick="() => selectedSpaceId = null">Close</button>
                </section>
            }
            else if (selectedSpaceId != null)
            {
                <section class="detail"><p>@SpaceHelp(view) <SpeakButton Text="@SpaceHelp(view)" Label="this space" /></p><button class="small" @onclick="() => selectedSpaceId = null">Close</button></section>
            }
            else
            {
                <p class="hint">Tip: click any space on the board to see its details.</p>
            }
            <label class="toggle"><input type="checkbox" @bind="Session.FastBots" /> Fast bots</label>
            <div class="save-row">
                <button class="small" @onclick="SaveNow">Save game</button>
                <button class="small" @onclick="Session.DownloadSaveAsync">Download save file</button>
                <a href="rules" target="_blank" rel="noopener">Rules</a>
                <button class="small" aria-expanded="@showSettings" @onclick="() => showSettings = !showSettings">Settings</button>
                <button class="small" @onclick='() => Nav.NavigateTo("")'>Menu</button>
            </div>
            @if (saveMessage != null) { <p class="hint" role="status">@saveMessage</p> }
            @if (showSettings) { <SettingsPanel /> }
        </aside>
    </div>

    @if (Session.Reveal is { } reveal)
    {
        <CouncilReveal Result="reveal" View="view" Content="Session.Content" OnClose="Session.DismissReveal" />
    }

    @if (Session.ShowPassScreen && request != null)
    {
        <PassScreen Name="@request.View.Me.Name" OnReady="Session.DismissPassScreen" />
    }
}

@code {
    private string? selectedSpaceId;
    private string? saveMessage;
    private bool showSettings;

    private async Task SaveNow()
    {
        saveMessage = await Session.SaveInBrowserAsync()
            ? "Saved in this browser. Use \"Continue saved game\" on the menu to carry on."
            : "The browser wouldn't keep the save (it may be full). Use \"Download save file\" instead.";
    }
    private string? previewFocusId;

    private void Answer(GameAction action)
    {
        previewFocusId = null;
        Session.Answer(action);
    }

    /// <summary>While choosing a Nudge or Precision dice, every space the player could land on is outlined on the board.</summary>
    private IReadOnlyCollection<string>? PreviewSpots(HumanRequest? request)
    {
        if (request == null || Session.ShowPassScreen) return null;
        var d = request.Decision;
        if (d.Kind == DecisionKind.ChooseNudge && d.Dice != null)
            return request.LegalActions.OfType<Nudge>()
                .Select(n => UiHelpers.LandingSpace(request.View, request.PlayerId, d.Dice.Sum() + n.Spaces).Id).ToHashSet();
        if (d.Kind == DecisionKind.ChoosePrecisionDice && d.Dice is { Count: 3 } dice)
            return request.LegalActions.OfType<ChooseDice>()
                .Select(c => UiHelpers.LandingSpace(request.View, request.PlayerId, dice[c.First] + dice[c.Second]).Id).ToHashSet();
        if (d.Kind == DecisionKind.PlayReaction && d.OtherPlayerId is int mover)
            return request.LegalActions.OfType<PlayCard>()
                .Select(p => UiHelpers.LandingSpace(request.View, mover, d.Spaces + p.Number).Id).ToHashSet();
        return null;
    }

    protected override void OnInitialized() => Session.Changed += Redraw;

    // The game runs in the background, so redraw through InvokeAsync, Blazor's safe way to update the page from outside a click.
    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= Redraw;

    private void Select(SpaceInfo space) => selectedSpaceId = selectedSpaceId == space.Id ? null : space.Id;

    private string SpaceHelp(PlayerView view)
    {
        var space = view.Spaces.First(s => s.Id == selectedSpaceId);
        return space.Kind switch
        {
            SpaceKind.Go => $"GO: collect {UiHelpers.Money(Session.Content.Rules.GoSalary)} each time you pass or land here.",
            SpaceKind.Jail => "Jail. Landing here by a normal move is just visiting.",
            SpaceKind.GoToJail => "Go straight to Jail. You don't pass GO.",
            SpaceKind.Tax => $"{space.Name}: pay {UiHelpers.Money(space.Id == "income-tax" ? Session.Content.Rules.IncomeTax : Session.Content.Rules.LuxuryTax)} to the bank.",
            SpaceKind.GovernmentTile when space.IsHiddenTile => "A hidden Government tile. It does nothing until someone lands on it and reveals it. Then it changes the properties either side of it.",
            SpaceKind.GovernmentTile => $"{UiHelpers.DisplayName(space, Session.Content)}. Next door: {Session.Content.GovTile(space.TileId!).NeighborText} Landing here: {Session.Content.GovTile(space.TileId!).LandingText}",
            SpaceKind.CityPark => $"City Park: land here to take {Session.Content.Rules.CityParkMomentum} Momentum token or draw an Opportunity card.",
            SpaceKind.Opportunity => "Opportunity: draw an Opportunity card. Only you see it; keep it in your hand to play later.",
            SpaceKind.Event => "Event: draw an Event card. It happens straight away, and everyone sees it.",
            SpaceKind.Landmark when space.Id == "mall" => $"The Mall: buy one of the three face-up Opportunity cards ({string.Join(", ", Session.Content.Rules.MallPrices.Select(UiHelpers.Money))}), or sell one of yours for {UiHelpers.Money(Session.Content.Rules.MallSellPrice)}.",
            SpaceKind.Landmark when space.Id == "hospital" => $"Hospital: visitors may buy an Insured marker for {UiHelpers.Money(Session.Content.Rules.InsuredMarkerCost)}. It cancels your next hospital bill.",
            SpaceKind.Landmark when space.Id == "casino" => "Casino: make one bet. High/Low against the bank, or a Dice Duel against another player.",
            SpaceKind.Landmark when space.Id == "stadium" => "Stadium: pick a color group. Its rent doubles until your next turn.",
            _ => $"{space.Name}. ",
        };
    }
}
